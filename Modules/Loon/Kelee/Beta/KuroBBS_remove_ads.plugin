#!name=库街区去广告
#!desc=移除开屏广告、弹窗广告、搜索页面的热搜及话题热榜。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1659339393
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-11-23 18:56:41

[Rewrite]
request if ${url} ~= /^https:\/\/api\.kurobbs\.com\/config\/getOpenScreen$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.kurobbs\.com\/config\/index\/windows$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.kurobbs\.com\/config\/search\/getSearchConfig\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.kurobbs\.com\/forum\/app\/topic\/hotlist\?/i then reject_dict(200)

[MITM]
hostname = api.kurobbs.com

