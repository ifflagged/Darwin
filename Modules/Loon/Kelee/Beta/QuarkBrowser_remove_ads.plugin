#!name=夸克去广告
#!desc=移除阅读广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1160172628
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rewrite]
request if ${url} ~= /^https:\/\/huichuan\.sm\.cn\/nativead$/i then reject(200)
request if ${url} ~= /^https:\/\/stars\.shuqireader\.com\/kkios\/render\/load\/resource\/appConfig$/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/open-cms-api\.quark\.cn\/open-cms/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/QuarkBrowser_remove_ads/QuarkBrowser_remove_ads.js") with tag="精简我的页面", requires_body=true

[MITM]
hostname = huichuan.sm.cn, stars.shuqireader.com, open-cms-api.quark.cn

