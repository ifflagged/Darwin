#!name=节点检测工具
#!desc=适用于Loon的节点检测工具，可进行地理位置、节点解锁、入口落地等查询。请在所有节点页面选择一个节点长按，出现菜单后进行测试。
#!author=xream[https://github.com/xream], Keywos[https://github.com/Keywos], KOP-XIAO[https://github.com/KOP-XIAO], dcpengx[https://github.com/dcpengx]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!tag=节点检测
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-06-10 23:31:23

[Script]
generic then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Node_detection_tool/NetworkEntryAndExitQueries.js") with tag="入口落地查询", timeout=10, img_url=", img-url=globe.asia.australia.system"

generic then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Node_detection_tool/LocationDetection.js") with tag="地理位置查询", timeout=10, img_url=", img-url=location.circle.system"

generic then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Node_detection_tool/NodeUnlockDetection.js") with tag="节点解锁查询", timeout=20, img_url=", img-url=play.circle.system"

