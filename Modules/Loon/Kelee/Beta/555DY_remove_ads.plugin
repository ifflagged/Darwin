[Rewrite]
response if ${url} ~= /^https:\/\/(app-v1\.ecoliving168\.com|852b95d36\.xwlpk\.cn)\/api\/v1\/movie\/index_recommend\?/i then response.json.jq(".data[].list |= map(select(.type != 3)) | .data |= map(select(.layout != \"advert_self\"))")

[MITM]
hostname = app-v1.ecoliving168.com, 852b95d36.xwlpk.cn

