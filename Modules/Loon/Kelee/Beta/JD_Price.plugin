[Script]
request if ${url} ~= /^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/JD_Price/JD_Price.js") with tag="捕获令牌", timeout=10, requires_body=true

response if ${url} ~= /^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/JD_Price/JD_Price.js") with tag="京东比价", timeout=10, requires_body=true

[MITM]
hostname = in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com

