#!name=快递100去广告
#!desc=移除横幅广告、弹窗广告，精简首页。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id458270120
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rewrite]
response if ${url} ~= /^https?:\/\/p\.kuaidi100\.com\/mobile\/mobileapi\.do$/i then response.json.delete(["adsplash", "adIsConsumable", "adProductId", "nologin_tips", "index_banner", "me_banner", "index_banner_shadow", "adshongbao", "adsapp_homepage_ticket_pop", "adsoptimizationsend", "adsapp_activity_ad_array", "adbanner", "adposition", "adShowAgainTime"])
response if ${url} ~= /^https?:\/\/p\.kuaidi100\.com\/apicenter\/xcx\.dox/i then response.json.delete("data.secondMenuList")
request if ${url} ~= /^https?:\/\/p\.kuaidi100\.com\/advertisement\//i then reject_dict(200)
request if ${url} ~= /^https?:\/\/p\.kuaidi100\.com\/e-commerce\/act\/actInfo\?/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/p\.kuaidi100\.com\/apicenter\/card\.dox/i then reject_dict(200)

[MITM]
hostname = p.kuaidi100.com

