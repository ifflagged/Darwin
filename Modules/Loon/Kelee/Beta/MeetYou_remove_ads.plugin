#!name=美柚去广告
#!desc=移除开屏广告、弹窗推广和信息流推广，移除青少年模式弹窗和我的页面推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id634896669
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rule]
DOMAIN,ad.seeyouyima.com,REJECT
DOMAIN,axxd.xmseeyouyima.com,REJECT

[Rewrite]
response if ${url} ~= /^https:\/\/common\.seeyouyima\.com\/v2\/conf_list$/i then response.json.delete("data.confList.Minor_mode_card")
request if ${url} ~= /^https:\/\/circle\.(xm)?seeyouyima\.com\/v\d\/article_recommend\?/i then reject(200)

[MITM]
hostname = circle.seeyouyima.com, circle.xmseeyouyima.com, common.seeyouyima.com

