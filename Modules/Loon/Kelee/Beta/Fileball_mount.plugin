#!homepage=https://github.com/luestr/ProxyResource/blob/main/Resource/Markdown/Fileball/README.md
#!date=2025-05-13 15:17:08

[Script]
request if ${url} ~= /^http:\/\/(aliyun|quark|pikpak)\.example\.com/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Fileball_mount/Fileball_mount.js") with tag="三合一网盘挂载", requires_body=true

[MITM]
hostname = aliyun.example.com, quark.example.com, pikpak.example.com

