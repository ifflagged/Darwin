#!name=蜻蜓FM去广告
#!desc=移除开屏广告、信息流广告、各类相关内容推荐，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id506685538
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rewrite]
response if ${url} ~= /^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/signin\/show_homepage_icon$/i then response.json.replace("data.display_icon", false)
response if ${url} ~= /^https:\/\/app\.qtfm\.cn\/recommendapi\/v\d\/hotpage\?/i then response.json.jq("del(.data.head[].data[] | select(.title == \"超级会员\")) | del(.data.head[].data[] | select(.link.type == \"RadioStation\")) | del(.data.head[] | select(.title == \"听头条\")) | del(.data.feeds[] | select(.type == \"ListenListRadio\"))")
response if ${url} ~= /^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/channel\/\d{6}\/playpage\/\d{8}/i then response.json.delete("data.related_recommend")
response if ${url} ~= /^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/mylistenpage/i then response.json.delete("data.banner")
response if ${url} ~= /^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/subscribed_channels\?/i then response.json.delete("data.recommends")
response if ${url} ~= /^https:\/\/entry\.qtfm\.cn\/api\/v\d\/personal\/\?carrier/i then response.json.jq("delpaths([[\"data\", \"membership\"], [\"data\", \"level_info\"]]) | .data.discovery.entries |= map(select(.title != \"借钱\"))")
request if ${url} ~= /^https:\/\/app\.qtfm\.cn\/recommendapi\/v\d\/emotion$/i then reject(200)
request if ${url} ~= /^https:\/\/search\.qtfm\.cn\/v\d\/keyword\/default$/i then reject(200)
request if ${url} ~= /^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/i_listen\/guess_you_like\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/recpage-c\.qtfm\.cn\/v\d\/favorites$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/user\.qtfm\.cn\/u\d\/api\/v\d\/user\/following_podcaster\?/i then reject_dict(200)

[MITM]
hostname = app.qtfm.cn, entry.qtfm.cn, recpage-c.qtfm.cn, user.qtfm.cn, search.qtfm.cn

