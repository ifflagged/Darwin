#!name=风鸟去广告
#!desc=移除首页信息流和轮播图
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1528682937
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rewrite]
request if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/user\/getBannerList/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/searchHotEnt/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/m\.riskbird\.com\/prod-qbb-api\/query\/person\/personRecommend/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/RiskBird_remove_ads/RiskBird_remove_ads.js") with tag="移除推荐老板", requires_body=true

[MITM]
hostname = m.riskbird.com

