#!name=知识星球去水印
#!desc=移除内容的水印编号
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1039749242
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rewrite]
response if ${url} ~= /^https:\/\/api\.zsxq\.com\/v2\/groups\/\d+$/i then response.json.replace("resp_data.group.policies.enable_watermark", false)
response if ${url} ~= /^https:\/\/articles\.zsxq\.com\/inline_form\/id_[a-z0-9]+\.html/i then response.body.replace(/name="group_enable_watermark" value="true"/, "name=\"group_enable_watermark\" value=\"false\"")

[MITM]
hostname = api.zsxq.com

