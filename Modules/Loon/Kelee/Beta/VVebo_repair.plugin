#!name=VVebo时间线修复
#!desc=修复失效的用户时间线和我的页面。使用此插件前需要禁用微博去广告插件，避免插件冲突导致失效。
#!author=suiyuran[https://github.com/suiyuran], androidcn[https://github.com/androidcn]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id670910957
#!tag=功能增强
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Script]
request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/users\/show\?/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/VVebo_repair/VVebo_repair.js") with tag="修复时间线"

request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/statuses\/user_timeline\?/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/VVebo_repair/VVebo_repair.js") with tag="修复时间线"

request if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/remind\/unread_count\?/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/VVebo_repair/VVebo_repair.js") with tag="修复时间线"

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/profile\/statuses\/tab\?/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/VVebo_repair/VVebo_repair.js") with tag="修复时间线", requires_body=true

response if ${url} ~= /^https:\/\/api\.weibo\.cn\/2\/cardlist\?/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/VVebo_repair/VVebo_repair.js") with tag="修复我的页面", requires_body=true

[MITM]
hostname = api.weibo.cn

