[Rewrite]
response if ${url} ~= /^https:\/\/api-release\.wuta-cam\.com\/ad_tree$/i then response.json.delete(["regular.splash", "big_day", "big_day_overrides", "regular.home_bottom_right_entry_v2", "regular.pic_upload_alert", "regular.retouching_before_icon"])
response if ${url} ~= /^https:\/\/api-release\.wuta-cam\.com\/ad_tree$/i then response.json.jq(".regular.homepage_25_bottom_nav_bar|=map(.button_list|=map(select(.name|IN(\"home\",\"me\"))))")

[MITM]
hostname = api-release.wuta-cam.com

