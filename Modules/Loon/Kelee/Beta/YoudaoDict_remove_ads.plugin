#!name=网易有道词典去广告
#!desc=移除开屏广告、弹窗广告、横幅广告、信息流广告、旧版翻译页面广告及搜索填充词。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id353115739
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rewrite]
response if ${url} ~= /^https:\/\/dict\.youdao\.com\/homepage\/toolbar\/get\?/i then response.json.delete("data.vipTag")
response if ${url} ~= /^https:\/\/dict\.youdao\.com\/course\/tab\/translateTab\?/i then response.json.delete("data")
response if ${url} ~= /^https:\/\/dict\.youdao\.com\/course\/tab\/home\?/i then response.json.delete(["data.popup", "data.tab", "data.searchSuggestList", "data.newBanner", "data.icon.promotionList", "data.icon.iconList[1].bubble", "data.icon.iconList[2].bubble", "data.icon.iconList[8].bubble"])
request if ${url} ~= /^https:\/\/gorgon\.youdao\.com\/gorgon\/brand\/prefetch\.s\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/gorgon\.youdao\.com\/gorgon\/request\.s\?/i then reject_dict(200)

[MITM]
hostname = gorgon.youdao.com, dict.youdao.com

