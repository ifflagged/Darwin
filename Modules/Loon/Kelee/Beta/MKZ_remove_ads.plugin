#!name=漫客栈去广告
#!desc=移除开屏广告、漫画广告、小说章末广告，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1189885433
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rewrite]
request if ${url} ~= /^https:\/\/base\.mkzcdn\.com\/advert\/app\/read\/v\d/i then reject_dict(200)
request if ${url} ~= /^https:\/\/base\.mkzcdn\.com\/advert\/app\/story\/read\/v\d/i then reject_dict(200)
request if ${url} ~= /^https:\/\/base\.mkzcdn\.com\/advert\/app\/task\/motivate\/v\d/i then reject_dict(200)
request if ${url} ~= /^https:\/\/base\.mkzcdn\.com\/advert\/app\/user\/slide\d\/v\d\//i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/base\.mkzcdn\.com\/app\/config\//i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/MKZ_remove_ads/MKZ_remove_ads.js") with tag="配置修改", requires_body=true

[MITM]
hostname = base.mkzcdn.com

