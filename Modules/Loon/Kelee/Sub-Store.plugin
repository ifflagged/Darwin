#!name=Sub-Store
#!desc=高级订阅管理工具，使用前请在本插件的详情页面为[PROXY]项分配代理策略。
#!author=Peng-YM[https://github.com/Peng-YM]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://sub.store
#!tag=订阅管理
#!loon_version=3.2.1(749)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08
#!select=节点缓存有效期,1分钟,5分钟,10分钟,30分钟,1小时,2小时,3小时,6小时,12小时,24小时,48小时,72小时
#!select=响应头缓存有效期,1分钟,5分钟,10分钟,30分钟,1小时,2小时,3小时,6小时,12小时,24小时,48小时,72小时

[Rule]
DOMAIN,sub-store.vercel.app,PROXY
DOMAIN,ip-api.com,PROXY

[Script]
request if ${url} ~= /^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info)))/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Sub-Store/sub-store-1.min.js") with tag="Sub-Store Core", timeout=120, requires_body=true

request if ${url} ~= /^https?:\/\/sub\.store/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Sub-Store/sub-store-0.min.js") with tag="Sub-Store Simple", timeout=120, requires_body=true

cron "0 0 1 ? * ?" then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Sub-Store/cron-sync-artifacts.min.js") with tag="Sub-Store Sync"

[MITM]
hostname = sub.store

