#!name=最右去广告
#!desc=移除开屏广告、信息流广告和广告轮播图。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id942443472
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-14 01:51:31

[Rule]
DOMAIN,adapi.izuiyou.com,REJECT
URL-REGEX,"^http:\/\/mercury-gateway\.ixiaochuan\.cn\/mercury\/v1\/ad\/",REJECT-DICT
URL-REGEX,"^http:\/\/file-share\.izuiyou\.com\/octopus\/media\/templates\/search_home_page_(nv|nv_v2)\/search_home_page_nv",REJECT

[Rewrite]
request if ${url} ~= /^https?:\/\/api\.izuiyou\.com\/config\/get_banner/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.izuiyou\.com\/ad\//i then reject(200)
request if ${url} ~= /^https:\/\/zyfile\.izuiyou\.com\/zyfile\/c2\/a0\/[a-z0-9-]+\.json/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/203\.107\.1\.1\/\d+\/ss/i then reject(200)
request if ${url} ~= /^https?:\/\/203\.107\.1\.33\/\d+\/ss/i then reject(200)
request if ${url} ~= /^https?:\/\/203\.107\.1\.66\/\d+\/ss/i then reject(200)
request if ${url} ~= /^https?:\/\/203\.107\.1\.67\/\d+\/ss/i then reject(200)
request if ${url} ~= /^https?:\/\/203\.107\.1\.97\/\d+\/ss/i then reject(200)
request if ${url} ~= /^https?:\/\/2401:b180:2000:30::1c\/\d+\/d/i then reject(200)
request if ${url} ~= /^https?:\/\/2401:b180:2000:20::10\/\d+\/d/i then reject(200)

[MITM]
hostname = api.izuiyou.com, zyfile.izuiyou.com, 203.107.1.1, 203.107.1.33, 203.107.1.66, 203.107.1.67, 203.107.1.97

