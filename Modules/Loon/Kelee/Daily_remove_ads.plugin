[Script]
response if ${url} ~= /^https?:\/\/m\.pvp\.xoyo\.com\/conf\/server-mapping$/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.splashConf\",\"data.splashConfNew\"]]]") with tag="body_rewrite_12", timeout=30, requires_body=true

[MITM]
hostname = m.pvp.xoyo.com

