#!name=得间小说去广告
#!desc=移除开屏广告、章末广告，移除扉页广告提示、听书界面广告提示、搜索栏填充词。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1454487240
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-09-04 22:36:17

[Rule]
DOMAIN,smad.ms.zhangyue.net,REJECT
DOMAIN,saad.ms.zhangyue.net,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/dj\.palmestore\.com\/djad\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/dj\.palmestore\.com\/zybk\/api\/ad\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/dj\.palmestore\.com\/zyapi\/bookstore\/ad\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/dj\.palmestore\.com\/zybk\/api\/bookshelf\/index\?/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/dj\.palmestore\.com\/zybk\/api\/powerup\/userGroup\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"body.sevenDaysAd\",\"body.shortPlayShow\",\"body.sdkShortPlayAB\"]]]") with tag="body_rewrite_15", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/dj\.palmestore\.com\/zybk\/api\/search\/index\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"body.keywords\"]]]") with tag="body_rewrite_19", timeout=30, requires_body=true

[MITM]
hostname = dj.palmestore.com

