#!name=前程无忧去广告
#!desc=移除开屏广告、弹窗、信息流推广、职位页面推广和各类横幅推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id415443644
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-07-11 17:40:27

[Rewrite]
request if ${url} ~= /^https:\/\/appapi\.51jobapp\.com\/api\/market\/get_launch\.php\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/operation\/get\/latest\/banner-list\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/51job-activities\/secJob\/queryHomeSecondConfigV2\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/jobs\/detail\/sesame-competitive\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/jobs\/job-detail\/user-rights\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/resume\/strategy\/resume-build\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/launch-hub\/open\/noauth\/popUp\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/launch-hub\/open\/noauth\/popUp\/getHomePagePopUp\?/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/noauth\/recommend\/job-tab-dynamic\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"resultbody.adsTabFeeds\"]]]") with tag="body_rewrite_14", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/user-task\/user\/task\//i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"resultbody.availableTaskList\"]]]") with tag="body_rewrite_18", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/cupid\.51jobapp\.com\/open\/tab\/good-job\/modules\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"resultbody.bannerList\"]]]") with tag="body_rewrite_22", timeout=30, requires_body=true

[MITM]
hostname = appapi.51jobapp.com, cupid.51jobapp.com

