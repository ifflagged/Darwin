#!name=猫耳FM去广告
#!desc=移除开屏广告、青少年模式弹窗、首页顶部入口，替换底栏的直播入口为发现入口。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1148465254
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-17 13:50:41

[Rewrite]
response if ${url} ~= /^https:\/\/app\.missevan\.com\/site\/config$/i then response.json.jq(".info.cronet |= (fromjson | .quic=false | tojson)")
response if ${url} ~= /^https:\/\/app\.missevan\.com\/site\/tabs\?/i then response.json.jq(".info.tabs |= map(select(.title as $t | [\"直播\", \"发现\", \"广播剧\", \"听书\", \"分类\"] | index($t) != null))")
response if ${url} ~= /^https:\/\/app\.missevan\.com\/site\/icons\?/i then response.json.jq(".info.icons |= map(select(.title as $t | $t == \"直播\" or $t == \"必听剧\" or $t == \"免费榜\" or $t == \"夜猫子\" or $t == \"启动音\"))")
response if ${url} ~= /^https:\/\/app\.missevan\.com\/discovery\/list$/i then response.json.jq(".info |= map(map(select(.title != \"免流服务\")))")
request if ${url} ~= /^https:\/\/data\.missevan\.com\/site\/ad-track$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/app\.missevan\.com\/x\/recommend\/get-popup$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/fm\.missevan\.com\/api\/v2\/meta\/banner$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/fm\.missevan\.com\/api\/v2\/recommended\/top\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/fm\.missevan\.com\/api\/v2\/chatroom\/sound\/recommend\?/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/app\.missevan\.com\/site\/launch\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"info.splash\",\"info.splash_ready\"]]]") with tag="body_rewrite_12", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/app\.missevan\.com\/site\/config$/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"info.tab_bar_live\",\"0\",\"info.enable_tab_bar_live_notice\",\"false\",\"info.teenager_popup_mode\",\"0\"]],[\"json-del\",[\"info.httpdns\",\"info.homepage_top_task_button\"]]]") with tag="body_rewrite_14", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/app\.missevan\.com\/site\/get-top$/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"info.search_words\"]]]") with tag="body_rewrite_24", timeout=30, requires_body=true

[MITM]
hostname = app.missevan.com, data.missevan.com, fm.missevan.com

