#!name=美颜相机去广告
#!desc=移除开屏广告、应用内弹窗，精简首页和我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id592331499
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rule]
DOMAIN,adui.tg.meitu.com,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/api\.meiyan\.com\/operation\/home_banner\.json\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.meiyan\.com\/vip\/permission_update_popup\.json\?/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/api\.meiyan\.com\/operation\/get_config\.json\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"response.time_limit\",\"response.bubble\",\"response.person_center\"]],[\"json-replace\",[[\"response.function_pop.meiyan_style.is_pop\",false],[\"response.onoff.vip_half_window_exit_remain_popup.open\",0],[\"response.onoff.vip_home_exit_remain_popup\",0]]]]") with tag="body_rewrite_16", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/api\.meiyan\.com\/operation\/home\.json\?/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/MeituMYXJ_remove_ads/MeituMYXJ_remove_ads.js") with tag="精简首页功能栏目并移除美颜推荐", requires_body=true

[MITM]
hostname = api.meiyan.com

