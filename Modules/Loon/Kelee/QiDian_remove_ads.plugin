[Rewrite]
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v4\/client\/getsplashscreen\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/adv\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/ywab\.reader\.qq\.com\/user\/experiments\/v2\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/checkin\/simpleinfo\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/push\/getdialog\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/message\/getpushedmessagelist$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/maintain\/playstrip$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/dailyrecommend\/recommendBook\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/freshman\/bookshelfbtn$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/bookshelf\/getTopOperation$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/booksearch\/hotWords\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/followsubscribe\/showChapterEndModule\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/young\/getconf$/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/client\/getconf$/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-replace\",[[\"Data.WolfEye\",0],[\"Data.CloudSetting.TeenShowFreq\",0]]],[\"json-del\",[\"Data.ActivityPageBackPushNoticeFrequency\",\"Data.ActivityIcon\",\"Data.ActivityPopup\",\"Data.LuckBag\"]]]") with tag="body_rewrite_12", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v2\/dailyrecommend\/getdailyrecommend\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-replace\",[[\"Data.Items\",[]]]]]") with tag="body_rewrite_19", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v3\/user\/getaccountpage\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"Data.BenefitButtonList\"]]]") with tag="body_rewrite_25", timeout=30, requires_body=true

[MITM]
hostname = magev6.if.qidian.com, ywab.reader.qq.com

