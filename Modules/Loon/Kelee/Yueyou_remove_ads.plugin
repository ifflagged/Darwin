#!name=阅友去广告
#!desc=移除开屏广告、弹窗广告和阅读页面广告，移除底栏福利按钮。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1066723192
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rule]
DOMAIN,ads.reader.yueyouxs.com,REJECT

[Script]
response if ${url} ~= /^https:\/\/goway\.reader\.yueyouxs\.com\/assemble\/app\/basic\/getAppInfo\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.isShowDLPopup\",\"data.isShowGame\",\"data.touTiaoShowDlPopup\",\"data.offLineDownload.WatchVideoBtnDesc\",\"data.readVipFirstCfg\",\"data.readVipNormalCfg\",\"data.notifyAd\",\"data.hotStartSplashTime\",\"data.hotStartReqSwitch\",\"data.isShowBFTab\",\"data.popReqDelayTime\",\"data.benefitCfg\",\"data.chestTask\",\"data.hotStartAd\",\"data.activeTagList\",\"data.secondOrderCfg\",\"data.secondOrderList\",\"data.blockedWordsCfg\",\"data.aaReportListCfg\",\"data.pddAdSwitch\",\"data.isShowShelfAuthPopup\",\"data.firstPopUpAmount\"]],[\"json-replace\",[[\"data.isAdClosed\",true]]]]") with tag="body_rewrite_14", timeout=30, requires_body=true

[MITM]
hostname = goway.reader.yueyouxs.com

