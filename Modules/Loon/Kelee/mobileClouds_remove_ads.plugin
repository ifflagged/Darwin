#!name=中国移动云盘去广告
#!desc=移除中国移动云盘开屏广告及应用内广告，首页的多余卡片可滑到最底部自定义隐藏掉，插件对此不做处理。
#!author=RuCu6[https://github.com/RuCu6]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1618137934
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Script]
response if ${url} ~= /^https:\/\/jzts\.cmpassport\.com\/personalized\/getPushContent/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/mobileClouds_remove_ads/mobileClouds_remove_ads.js") with tag="移除开屏广告", requires_body=true

response if ${url} ~= /^https:\/\/ad\.mcloud\.139\.com\/advertapi\/adv-filter\//i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/mobileClouds_remove_ads/mobileClouds_remove_ads.js") with tag="移除应用内广告", requires_body=true

[MITM]
hostname = jzts.cmpassport.com, ad.mcloud.139.com

