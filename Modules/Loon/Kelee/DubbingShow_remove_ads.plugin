#!date=2025-05-13 15:17:08

[Script]
response if ${url} ~= /^https:\/\/iosapi\.peiyinxiu\.com\/Api\/live\/LiveList/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.banners\"]]]") with tag="body_rewrite_12", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/iosapi\.peiyinxiu\.com\/api\/live\/FollowList/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"obj.data\"]]]") with tag="body_rewrite_13", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/iosapi\.peiyinxiu\.com\/Api\/Friend\/GetRecommendUsers/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"obj.data\"]]]") with tag="body_rewrite_14", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/iosapi\.peiyinxiu\.com\/api\/Union\/HomeData/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"obj.data\"]]]") with tag="body_rewrite_15", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/iosapi\.peiyinxiu\.com\/Api\/Film\/GetConfigValue/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/DubbingShow_remove_ads/DubbingShow_remove_ads.js") with tag="移除首页底部弹窗", requires_body=true

[MITM]
hostname = iosapi.peiyinxiu.com

