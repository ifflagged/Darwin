#!name=美图秀秀去广告
#!desc=移除开屏广告、横幅推广，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id416048305
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-08-31 18:06:06

[Rule]
DOMAIN,adui.tg.meitu.com,REJECT

[Script]
response if ${url} ~= /^https:\/\/api\.posters\.meitu\.com\/common\/init\.json/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.vip\"]]]") with tag="body_rewrite_14", timeout=30, requires_body=true

[MITM]
hostname = api.posters.meitu.com

