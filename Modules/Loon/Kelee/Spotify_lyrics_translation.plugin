#!name=Spotify歌词增强
#!desc=将Spotify的外语歌词翻译为简体中文，并提供双语翻译支持。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id324684580
#!tag=功能增强
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Script]
response if ${url} ~= /^https?:\/\/api\.spotify\.com\/v1\/tracks\?/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Spotify_lyrics_translation/Spotify_response.js") with tag="跟踪响应·JSON", requires_body=true

request if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Spotify_lyrics_translation/Spotify_request.js") with tag="歌词请求·JSON", requires_body=true

request if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Spotify_lyrics_translation/Spotify_request.js") with tag="歌词请求·Proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=Translate/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Spotify_lyrics_translation/Translate_response.js") with tag="翻译歌词响应·JSON", requires_body=true

response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=Translate/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Spotify_lyrics_translation/Translate_response.js") with tag="翻译歌词响应·Proto", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=External/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Spotify_lyrics_translation/External_Lyrics_response.js") with tag="外部歌词响应·JSON", requires_body=true

response if ${url} ~= /^https?:\/\/spclient\.wg\.spotify\.com\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=External/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Spotify_lyrics_translation/External_Lyrics_response.js") with tag="外部歌词响应·Proto", requires_body=true, binary_body_mode=true

[MITM]
hostname = api.spotify.com, spclient.wg.spotify.com

