#!name=美丽修行去广告
#!desc=移除开屏广告、首页广告、发现页广告、美修盒页面广告、下拉广告、弹窗广告、搜索推广、版本更新弹窗及我的页面广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1089854728
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-11-26 23:28:08

[Rewrite]
response if ${url} ~= /^https:\/\/api\.bevol\.com\/appmain\/app\/home\/feed$/i then response.json.jq(". | .result.returnList |= (map(select(.tname == \"userPart\"))) | .result.returnList |= map(select(. | has(\"adId\") | not))")
request if ${url} ~= /^https:\/\/api\.bevol\.com\/appmain\/app\/home\/launch$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.bevol\.com\/appmain\/app\/home\/popup$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.bevol\.com\/personal\/page$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.bevol\.com\/seach\/foundAndTopSearch$/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/api\.bevol\.com\/appmain\/app\/home\/page$/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"result.versionPopUp\",\"result.isShowSearchLabel\",\"result.isShowSearchFeedBack\",\"result.centerBannerAdvert\",\"result.programmaticAdvertising\",\"result.mattsData\",\"result.questionnaireMap\",\"result.appPullDownAdvert\"]]]") with tag="body_rewrite_15", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/api\.bevol\.com\/appmain\/app\/home\/feed$/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"result.banners\"]]]") with tag="body_rewrite_16", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/api\.bevol\.com\/trialbox\/shop\/app\/homePage$/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"result.firstPersonActivity\",\"result.mainActivity\",\"result.brandZone\",\"result.imageAD2\",\"result.couponPopupInfo\"]]]") with tag="body_rewrite_18", timeout=30, requires_body=true

[MITM]
hostname = api.bevol.com

