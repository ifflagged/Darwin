#!name=米游社去广告
#!desc=移除开屏广告、搜索栏热搜及资讯、青少年模式弹窗。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1470182559
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-11-20 01:12:36

[Rewrite]
request if ${url} ~= /^https:\/\/bbs-api(-ab)?\.miyoushe\.com\/apihub\/api\/getAppSplash$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/bbs-api(-ab)?\.miyoushe\.com\/apihub\/api\/getHotKeywordAndEvent$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/bbs-api-static\.miyoushe\.com\/search\/api\/search\/pre_keyword\?/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/bbs-api(-ab)?\.miyoushe\.com\/apihub\/api\/getAppStartupData$/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.resp_map./teenager/api/info\",\"data.resp_map[\\\"/apihub/api/getAppConfig\\\"].data.get_app_config_response.config.is_show_teenager_mode_btn\",\"data.resp_map[\\\"/apihub/api/getAppConfig\\\"].data.get_app_config_response.config.teenager_popup_freq_type\"]]]") with tag="body_rewrite_13", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/bbs-api(-ab)?\.miyoushe\.com\/apihub\/api\/getAppConfig$/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-replace\",[[\"data.config.teenager_popup_freq_type\",0],[\"data.config.is_show_teenager_mode_btn\",0]]]]") with tag="body_rewrite_14", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/bbs-api-ab\.miyoushe\.com\/teenager\/api\/info$/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-replace\",[[\"data.is_enabled\",false],[\"data.is_teenager\",false],[\"data.is_force\",false]]]]") with tag="body_rewrite_15", timeout=30, requires_body=true

[MITM]
hostname = bbs-api.miyoushe.com, bbs-api-ab.miyoushe.com

