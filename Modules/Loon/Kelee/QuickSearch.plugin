#!name=快捷搜索
#!desc=为Safari提供快速切换搜索引擎的能力，在插件列表中点击此插件上的链接查看使用方法。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://github.com/luestr/ProxyResource/blob/main/Resource/Markdown/QuickSearch/README.md
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rewrite]
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=bd\+([^&]+).+/i then redirect(307, "https://www.baidu.com/s?wd=$1")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=bdimg\+([^&]+).+/i then redirect(307, "https://image.baidu.com/search/index?tn=baiduimage&word=$1")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gimg\+([^&]+).+/i then redirect(307, "https://www.google.com/search?&tbm=isch&q=$1")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=b\+([^&]+).+/i then redirect(307, "https://www.bing.com/search?q=$1")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=wk\+([^&]+).+/i then redirect(307, "https://zh.wikipedia.org/wiki/$1")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=qm\+([^&]+).+/i then redirect(307, "https://www.qimai.cn/search/index/country/cn/search/$1")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=gh\+([^&]+).+/i then redirect(307, "https://github.com/search?q=$1")
request if ${url} ~= /^https:\/\/duckduckgo\.com\/\?q=([^&]+).+/i then redirect(307, "https://www.google.com/search?q=$1")

[MITM]
hostname = duckduckgo.com

