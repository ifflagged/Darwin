#!name=粉笔去广告
#!desc=移除开屏广告、弹窗广告、悬浮广告、热门搜索，移除底栏皮肤，精简我的页面。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id584660358
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-11-27 20:44:18

[Rewrite]
request if ${url} ~= /^https:\/\/keapi\.fenbi\.com\/app\/(iphone|ipad)\/position_resource\/get_banners\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/market-api\.fenbi\.com\/(iphone|ipad)\/v1\/assistant\/info\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/keapi\.fenbi\.com\/app\/(iphone|ipad)\/position_resource\/get_home_banners\?.*position_resource_type=2/i then reject_dict(200)
request if ${url} ~= /^https:\/\/keapi\.fenbi\.com\/app\/iphone\/\w+\/reddot\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ke\.fenbi\.com\/(iphone|ipad)\/v3\/timetable\/today_with_public_episodes\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/hera-webapp\.fenbi\.com\/(iphone|ipad)\/topic\/hotquery\/list\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/hera-webapp\.fenbi\.com\/(iphone|ipad)\/explore\/consts\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/hera-webapp\.fenbi\.com\/(iphone|ipad)\/announcement\/hotquery\/list\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ke\.fenbi\.com\/(iphone|ipad)\/v3\/user_member\/entry\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/market-api\.fenbi\.com\/(iphone|ipad)\/v1\/assistant\/my\?/i then reject_dict(200)
response if ${url} ~= /^https:\/\/keapi\.fenbi\.com\/app\/(iphone|ipad)\/position_resource\/get_home_banners\?.*position_resource_type=1/i then response.body.mock("json", "{", 200)

[Script]
response if ${url} ~= /^https:\/\/hera-webapp\.fenbi\.com\/(iphone|ipad)\/recommend\/info\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.rollingBanner\"]]]") with tag="body_rewrite_20", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/ke\.fenbi\.com\/(iphone|ipad)\/v3\/apps\/config\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.bottomIconInfos.position.iconDefaultUrl\",\"data.bottomIconInfos.position.iconSelectedUrl\",\"data.bottomIconInfos.position.nightModeIconDefaultUrl\",\"data.bottomIconInfos.position.nightModeIconSelectedUrl\"]]]") with tag="body_rewrite_22", timeout=30, requires_body=true

[MITM]
hostname = keapi.fenbi.com, market-api.fenbi.com, ke.fenbi.com, hera-webapp.fenbi.com

