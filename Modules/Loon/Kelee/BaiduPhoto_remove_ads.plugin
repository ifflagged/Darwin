#!name=一刻相册去广告
#!desc=移除开屏广告、横幅广告和弹窗推广。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1467852587
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rewrite]
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/act\/api\/conf\?.*conf_key=youa_core_config_ios/i then reject_dict(200)
request if ${url} ~= /^https:\/\/pan\.baidu\.com\/youai\/material\/v1\/getbynavid\?.*nav_id=1/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/mbd\.baidu\.com\/ccs\/v1\/start\/confsync\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.service.config.advertisement\",\"data.service.config.youa.pm_config_ad\"]]]") with tag="body_rewrite_14", timeout=30, requires_body=true

[MITM]
hostname = pan.baidu.com, mbd.baidu.com

