#!name=百度输入法去广告
#!desc=过滤百度输入法广告，替换个人主页随机图。
#!author=Keywos[https://github.com/Keywos]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id916139408
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rewrite]
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/v5\/start_screen_ads\/list/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/sapi\/v1\/lccorpus\/(applist|pannellist)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/sapi\/v1\/(circle\/joinedlist|lccorpus\/usercorpussync|aihelpactivity\/aihelpresource)/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/mime\.baidu\.com\/commer\/pocket_api\/enterprise_list/i then reject_dict(200)
request if ${url} ~= /^https?:\/\/mbd\.baidu\.com\/ccs\/v1\/start\/confsync\?appname=baidu_input/i then reject_dict(200)
request if ${url} ~= /^https:\/\/mime\.baidu\.com\/v5\/(fb\/st\?logtype|(notiv3|cellloc_noti|noti_cloudswitch_noti)\/info)/i then reject_dict(200)

[Script]
response if ${url} ~= /^https?:\/\/mime\.baidu\.com\/(imrobot\/v1\/pub\/relation\/get_robot_list|v5\/custom_page\/(layout|getdata))/i then script("https://github.com/ifflagged/Darwin/raw/main/Modules/JS/Kelee/Baidu_input_method_remove_ads/Baidu_input_method_remove_ads.js") with tag="百度输入法去广告", requires_body=true

[MITM]
hostname = imeres.baidu.com, mbd.baidu.com, mime.baidu.com

