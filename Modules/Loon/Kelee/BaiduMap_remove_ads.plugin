#!name=百度地图去广告
#!desc=移除开屏广告、出行页面推广、周边页面推广、打车页面推广，精简我的页面。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。
#!author=可莉🅥[https://getupnote.com/share/notes/zSn1ShBmzNYISKcTgjXE5oHMrNf2/34bf3aad-7872-497d-b239-198e27e8c84c]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id452186370
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://getupnote.com/share/notes/zSn1ShBmzNYISKcTgjXE5oHMrNf2/34bf3aad-7872-497d-b239-198e27e8c84c
#!date=2025-05-13 15:17:08

[Rewrite]
request if ${url} ~= /^https:\/\/afd\.baidu\.com\/afd\/entry\?action=(update|query)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yongche\.baidu\.com\/gomarketing\/api\/popup\/getentrancecordovaurl$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/cobuild\/pull\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/operationgirdle$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/baseinfo$/i then reject_dict(200)
request if ${url} ~= /^https:\/\/ecom\.map\.baidu\.com\/ad-ops\/afd\/popup\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/maphotel\.baidu\.com\/hotel\/goextranet\/activity\/detail\?/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/newclient\.map\.baidu\.com\/feed\/govui\/rich_content/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data\"]]]") with tag="body_rewrite_13", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/newclient\.map\.baidu\.com\/client\/noticebar\/get\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"content.multi_data\"]]]") with tag="body_rewrite_14", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/newclient\.map\.baidu\.com\/(client\/)?usersystem\/mine\/page\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-replace\",[[\"data\",{}]]]]") with tag="body_rewrite_15", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/newclient\.map\.baidu\.com\/client\/phpui2\/\?qt=ads&type=user_home_new_service/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"ads\"]]]") with tag="body_rewrite_16", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/newclient\.map\.baidu\.com\/living\/nearby\/api\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"Result.cards[1]\",\"Result.cards[4]\",\"Result.cards[5]\",\"Result.cards[9]\"]]]") with tag="body_rewrite_23", timeout=30, requires_body=true

[MITM]
hostname = afd.baidu.com, newclient.map.baidu.com, yongche.baidu.com, ecom.map.baidu.com

