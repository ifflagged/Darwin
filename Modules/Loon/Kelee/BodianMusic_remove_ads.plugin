#!name=波点音乐去广告
#!desc=精简应用配置，禁用P2P传输。移除开屏广告、横幅推广、悬浮广告、歌曲广告、商城入口、搜索推广、评论区推广、试听语音提醒。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1541981555
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-08-31 03:36:08

[Rewrite]
response if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/service\/home\/index\?/i then response.json.jq(".data.moduleList |= map(select(.type | tostring | (. != \"8\" and . != \"1\")))")
response if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/service\/music\/recommendList\?/i then response.json.jq(".data.musicList[] |= del(.showAd)")
request if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/(play|service|advert)\/advert\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/service\/banner\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/ucenter\/vip\/give\/config\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/service\/home\/module\?.*&moduleId=6/i then reject_dict(200)
request if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/lowPriceText\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/vipEnter\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/popup\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/invitation\/swell\/popup\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/service\/version\/popup\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/invitation\/assist\/popup\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/pay\/h5\/common\/popup\?/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/service\/conf\/all\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.groupSign.adStartAppDialog\",\"data.groupSign.adGuideTest\",\"data.groupSign.playTips\",\"data.groupSign.adExitChange\",\"data.conf.adGuidePopCount\",\"data.conf.adDownListOpen\"]],[\"json-replace\",[[\"data.conf.flowControlConfig.uploadEnable\",false],[\"data.conf.flowControlConfig.p2pEnable\",false]]]]") with tag="body_rewrite_13", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/ab-bodian\.kuwo\.cn\/abtest\/ui\/info\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.mapTestInfo.CommentADPosition\",\"data.mapTestInfo.DiscoverADPosition\",\"data.mapTestInfo.DownloadAd\",\"data.mapTestInfo.FreeModVoiceReminder\",\"data.mapTestInfo.GamesTrans\",\"data.mapTestInfo.bodianmvdialog\",\"data.mapTestInfo.MvTryShowAds\",\"data.mapTestInfo.insert\"]]]") with tag="body_rewrite_15", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.iosP2PCacheEnable\",\"data.warmStartDialog\",\"data.adsNotFinishVipPop4DayInterval\"]],[\"json-replace\",[[\"data.showShopEntry\",false],[\"data.iosP2pEnableSendDataLimit\",1]]]]") with tag="body_rewrite_16", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/search\/topic\/word\/list\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"data.hotTopic\",\"data.searchFind\",\"data.globalJumpInfo\",\"data.hotWord\"]]]") with tag="body_rewrite_20", timeout=30, requires_body=true

response if ${url} ~= /^https:\/\/bd-api\.kuwo\.cn\/api\/comments\/v3\/topInfo\?/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\".data.putao\",\"data.bannerVos\"]]]") with tag="body_rewrite_24", timeout=30, requires_body=true

[MITM]
hostname = bd-api.kuwo.cn

