#!name=KOOK去广告
#!desc=移除开屏广告、房间横幅推广、精简我的页面，移除底栏商城入口。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Loon.png
#!tag=Jacob

#!openUrl=https://apps.apple.com/app/id1501289327
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!date=2025-05-13 15:17:08

[Rewrite]
request if ${url} ~= /^https:\/\/www\.kookapp\.cn\/api\/v3\/ad\/config$/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/(m|www)\.kookapp\.cn\/api\/v\d\/user\/settings$/i then script("https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js", "[[\"json-del\",[\"ad_banner\",\"advertise_on_off\"]],[\"json-replace\",[[\"ios_mall_switch\",false]]]]") with tag="body_rewrite_13", timeout=30, requires_body=true

[MITM]
hostname = m.kookapp.cn, www.kookapp.cn

