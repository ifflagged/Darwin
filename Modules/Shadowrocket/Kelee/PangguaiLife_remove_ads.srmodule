[URL Rewrite]
^https:\/\/userapi\.qiekj\.com\/slot\/get$ - reject-dict
^https:\/\/userapi\.qiekj\.com\/appTitle\/get$ - reject-dict
^https:\/\/userapi\.qiekj\.com\/integralRecord\/integralDailStatistics$ - reject-dict
^https:\/\/userapi\.qiekj\.com\/local-life\/category$ - reject-dict
^https:\/\/userapi\.qiekj\.com\/integralGoods\/queryIntegralGoodsPage$ - reject-dict
^https:\/\/userapi\.qiekj\.com\/task\/list$ - reject-dict

[Script]
body_rewrite_14 = type=http-response, pattern=^https:\/\/userapi\.qiekj\.com\/local-life\/tab-order$, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=%5B%5B%22json-replace%22%2C%5B%5B%22data%22%2C%5B%5D%5D%5D%5D%5D

body_rewrite_15 = type=http-response, pattern=^https:\/\/userapi\.qiekj\.com\/integralGoods\/queryIntegralGoodsCategoryList$, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=%5B%5B%22json-replace%22%2C%5B%5B%22data%22%2C%5B%5D%5D%5D%5D%5D

[MITM]
hostname = %APPEND% userapi.qiekj.com

